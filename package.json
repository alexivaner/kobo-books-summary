{
  "name": "kobo-books-summary",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev apps/web --webpack --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build apps/web --webpack && node scripts/precache.mjs",
    "start": "node scripts/serve.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "assets": "node scripts/assets.mjs",
    "postinstall": "node scripts/assets.mjs",
    "fixtures": "node scripts/fixtures.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "echarts": "6.1.0",
    "fflate": "0.8.3",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.15.2",
    "tailwindcss": "4.3.4",
    "zod": "4.6.7"
  },
  "type": "module",
  "license": "MIT",
  "author": "Ivan Surya Hutomo",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexivaner/readmory.git"
  }
}
